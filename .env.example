DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/banco_db
CENTRAL_API_URL=https://centralbank.brocoly.cc/api
CENTRAL_API_KEY=
CENTRAL_BANK_CODE=
CENTRAL_ENV=test
ADMIN_USER=admin
ADMIN_PASS=
# Rendimientos: tasa nominal anual (%) que se aplica al saldo de cada caja
RENDIMIENTO_TNA_ARS=30
RENDIMIENTO_TNA_USD=1
# Cotización del dólar (opcional; por defecto usa MonedAPI)
# MONEDAPI_URL=https://monedapi.ar/api/v2

# Verificación por correo con Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Para enviar a correos reales hay que verificar un dominio en Resend y usar un remitente de ese dominio.
# Con onboarding@resend.dev solo llega al correo dueño de tu cuenta de Resend.
MAIL_FROM=Banco La Cobra <no-reply@tudominio.com>
# Opcionales (valores por defecto)
# CODIGO_TTL_MIN=10
# CODIGO_MAX_INTENTOS=5
# CODIGO_REENVIO_SEG=60
# CODIGO_MAX_ENVIOS_HORA=5
